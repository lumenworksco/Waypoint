    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Welcome to Piste</string>
    <string name="onboarding_welcome_desc">Your ski companion for tracking runs, saving spots, and exploring the mountain.</string>
    <string name="onboarding_waypoints_title">Mark your spots</string>
    <string name="onboarding_waypoints_desc">Long-press anywhere on the map to drop a waypoint. Add photos, notes, colors, and ski-themed icons.</string>
    <string name="onboarding_tracking_title">Track your runs</string>
    <string name="onboarding_tracking_desc">Tap the red record button to start tracking. Your vertical, max speed, and runs are detected automatically.</string>
    <string name="onboarding_dashboard_title">Live dashboard</string>
    <string name="onboarding_dashboard_desc">Tap the coordinate header for a full-screen speedometer with altitude and vertical descended.</string>
    <string name="onboarding_explore_title">Explore the mountain</string>
    <string name="onboarding_explore_desc">Switch between Standard, Piste, Terrain, and Satellite maps. Download tiles to use the app offline.</string>

